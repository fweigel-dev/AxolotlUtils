{
	"schemaVersion": 1,
	"id": "axolotlutils",
	"version": "${version}",
	"name": "Axolotl Utils",
	"description": "Utilities for axolotl hunting: blue axolotl highlighting, colored buckets, and breeding tracker.",
	"authors": [
		"fweigel-dev"
	],
	"contact": {
		"homepage": "https://github.com/fweigel-dev/AxolotlUtils",
		"sources": "https://github.com/fweigel-dev/AxolotlUtils",
		"issues": "https://github.com/fweigel-dev/AxolotlUtils/issues"
	},
	"license": "CC-BY-4.0",
	"icon": "assets/axolotlutils/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.fweigel.AxolotlUtils"
		],
		"client": [
			"dev.fweigel.AxolotlUtilsClient"
		],
		"modmenu": [
			"dev.fweigel.AxolotlUtilsModMenu"
		]
	},
	"mixins": [
		"axolotlutils.mixins.json",
		{
			"config": "axolotlutils.client.mixins.json",
			"environment": "client"
		}
	],
"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": ">=26.3",
		"java": ">=21",
		"fabric-api": "*",
		"fweigel-util-lib": ">=1.7.0"
	},
	"suggests": {
		"modmenu": "*"
	}
}
